# ---------------------------------------------------------------------------
# SkelClock environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Supabase (backend database + auth) ------------------------------------
# Create the project in the ap-southeast-2 (Sydney) region for AU hosting.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Odoo -------------------------------------------------------------------
# ODOO_URL      e.g. https://skelscaff.odoo.com  (no trailing slash)
# ODOO_DB       the database name. On Odoo Online this is usually the subdomain.
# ODOO_USERNAME the integration user's login (create a dedicated API user).
# ODOO_API_KEY  Settings > Users > (user) > Account Security > New API Key.
#               Use an API key, not the account password.
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# Which Odoo model represents a SkelScaff job. One of:
#   project.project | sale.order | x_skelscaff_job (custom)
# See packages/odoo/src/mapping.ts — this is the one knob that changes if the
# answer turns out to be different from what we assume.
ODOO_JOB_MODEL=project.project

# Which model represents a work activity / cost code. One of:
#   project.task | account.analytic.account | x_skelscaff_activity
ODOO_ACTIVITY_MODEL=project.task

# Set to "mock" to run the whole stack against fixtures with no live Odoo.
# Set to "live" once the credentials above are filled in.
ODOO_MODE=mock

# --- App --------------------------------------------------------------------
APP_TIMEZONE=Australia/Sydney
# Shifts longer than this raise a "very long shift" exception.
LONG_SHIFT_HOURS=14
# Default geofence radius (metres) when a site has none set.
DEFAULT_GEOFENCE_RADIUS_M=200
