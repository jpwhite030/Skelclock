{
  "name": "skelclock",
  "private": true,
  "version": "0.1.0",
  "description": "SkelScaff field attendance — clock in/out, GPS, offline, Odoo sync",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "poc": "node --import tsx scripts/poc.ts",
    "test": "node --import tsx --test packages/core/src/core.test.ts packages/odoo/src/odoo.test.ts apps/mobile/src/queue.test.ts scripts/integration.test.ts",
    "test:unit": "node --import tsx --test packages/core/src/core.test.ts packages/odoo/src/odoo.test.ts apps/mobile/src/queue.test.ts",
    "odoo:probe": "node --import tsx scripts/odoo-probe.ts",
    "shots": "node --import tsx scripts/shots.ts",
    "typecheck": "npm run typecheck:packages && npm run typecheck:web && npm run typecheck:mobile",
    "typecheck:packages": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck:mobile": "tsc --noEmit -p apps/mobile/tsconfig.json"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^24.10.1",
    "playwright-core": "^1.62.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
